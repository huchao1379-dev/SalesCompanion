PORT=8787
# Local: 127.0.0.1 | Server/cloud: 0.0.0.0
HOST=0.0.0.0
# deepseek = demo default
# openai = OpenAI Responses API (default model gpt-6-luna)
# copilotstudio = optional explicit opt-in; requires the Direct Engine URL + auth below
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (AI_PROVIDER=openai) — uses /v1/responses for gpt-6-luna
# Example:
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# Default gpt-6-luna; aliases gpt6-luna / gpt_6_luna are normalized
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max (Luna default in API is medium; demo uses low)
OPENAI_REASONING_EFFORT=low

# Optional OpenAI-compatible vision model for chat image attachments.
# deepseek-chat is text-only — set VISION_MODEL to a multimodal model (e.g. gpt-4o-mini).
# When AI_PROVIDER=openai, vision defaults to the same OpenAI key + gpt-6-luna.
# VISION_API_KEY / VISION_BASE_URL default to the active chat provider when omitted.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Copilot Studio Direct Engine endpoint. This URL is not a credential.
COPILOTSTUDIO_DIRECT_CONNECT_URL=https://beebc20574e3ec54ba7f528ddc96de.94.environment.api.powerplatform.com/copilotstudio/agenticruntime/3p/dataverse-backed/authenticated/bots/cr590_salesassistant_BkoRB7/conversations?api-version=2022-03-01-preview
# Development only: short-lived JWT. Do not commit or expose this in the frontend.
COPILOTSTUDIO_ACCESS_TOKEN=
# Production: Entra service principal (used when ACCESS_TOKEN is empty).
COPILOTSTUDIO_TENANT_ID=
COPILOTSTUDIO_CLIENT_ID=
COPILOTSTUDIO_CLIENT_SECRET=
# Dataverse Web API — REQUIRED (API will not start without these)
# Example: https://orgxxxxxxxx.crm.dynamics.com
DATAVERSE_URL=
# Auth option A: short-lived bearer (dev only)
DATAVERSE_TOKEN=
# Auth option B: Entra app registration (recommended)
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
# Table/column prefix (this env uses hc). Must match Maker publisher.
DATAVERSE_PREFIX=hc
# Choice option base (this org's publisher uses 122990000)
DATAVERSE_CHOICE_BASE=122990000
PROMPT_VERSION=demo-deepseek-v2

# Optional: live web search/fetch for general_assist (off when key empty)
# Provider: serper (default) | tavily
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=
# WEB_SEARCH_BASE_URL=
# Fetch https pages: auto-on when search key is set; force with 1/true, off with 0/false
# WEB_FETCH_ENABLED=

# 讯飞语音 — 国内可用，密钥仅服务端
# 听写：控制台开通「语音听写（流式版）」→ /api/speech/iat/*
# 合成：控制台开通「在线语音合成（流式版）」并添加发音人 → /api/speech/tts（每日播报 / Copilot 朗读）
# https://console.xfyun.cn/
# SPEECH_PROVIDER=auto|iflytek|webspeech（auto：有密钥用讯飞，否则浏览器 Web Speech）
SPEECH_PROVIDER=auto
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
# IFLYTEK_TTS_VCN=xiaoyan
# IFLYTEK_LANGUAGE=zh_cn
# IFLYTEK_DOMAIN=iat
# IFLYTEK_ACCENT=mandarin
# IFLYTEK_DWA=wpgs
# IFLYTEK_VAD_EOS=3000
