PORT=8787
# Local: 127.0.0.1 | Server/cloud: 0.0.0.0
HOST=0.0.0.0
# deepseek = demo default (required for this demo)
# copilotstudio = optional explicit opt-in; requires the Direct Engine URL + auth below
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI-compatible vision model for chat image attachments.
# deepseek-chat is text-only — set VISION_MODEL to a multimodal model (e.g. gpt-4o-mini).
# VISION_API_KEY / VISION_BASE_URL default to DEEPSEEK_* when omitted.
# 视图需要使用其他模型
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Copilot Studio Direct Engine endpoint. This URL is not a credential.
COPILOTSTUDIO_DIRECT_CONNECT_URL=https://beebc20574e3ec54ba7f528ddc96de.94.environment.api.powerplatform.com/copilotstudio/agenticruntime/3p/dataverse-backed/authenticated/bots/cr590_salesassistant_BkoRB7/conversations?api-version=2022-03-01-preview
# Development only: short-lived JWT. Do not commit or expose this in the frontend.
COPILOTSTUDIO_ACCESS_TOKEN=
# Production: Entra service principal (used when ACCESS_TOKEN is empty).
COPILOTSTUDIO_TENANT_ID=
COPILOTSTUDIO_CLIENT_ID=
COPILOTSTUDIO_CLIENT_SECRET=
# Optional: real Dataverse Web API (leave empty to use in-memory seed store)
DATAVERSE_URL=
DATAVERSE_TOKEN=
PROMPT_VERSION=demo-deepseek-v2
# Optional: absolute path if repo layout differs on server
# SEED_PATH=/var/www/SalesCompanion/dataverse/seed/seed.json
