# Frontend (Vite) — used at build time for Power Apps / online publish.
# Leave empty for local `npm run dev` (proxies /api → 127.0.0.1:8787).
# Online: set to your publicly reachable SalesCompanion API, e.g.
# VITE_API_BASE=https://your-api.example.com/api
VITE_API_BASE=
# copilotstudio uses the server-side Microsoft Agents SDK; deepseek keeps the existing model path.
VITE_CHAT_PROVIDER=deepseek
# Speech: auto|iflytek|webspeech — auto follows server /api/health (讯飞 if configured)
# VITE_SPEECH_PROVIDER=auto

